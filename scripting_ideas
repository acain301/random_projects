#!/usr/bin/env bash
set -euo pipefail

# Colors
RED="\e[31m"
GREEN="\e[32m"
YELLOW="\e[33m"
BLUE="\e[34m"
BLINK="\e[5m"
RESET="\e[0m"

if [[ -z "${VIRTUAL_ENV:-}" ]]; then
    echo -e "${RED}No virtual environment is active.${RESET}"
    exit 1
fi

if ! command -v pytest >/dev/null 2>&1; then
    echo -e "${RED}pytest is NOT installed in the active virtual environment.${RESET}"
    exit 1
fi

echo -e "${GREEN}pytest is installed in the active virtual environment.${RESET}"
echo -e "${YELLOW}Path to virtual environment ---> $VIRTUAL_ENV${RESET}"
